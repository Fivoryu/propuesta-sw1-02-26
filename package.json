{
  "name": "propuestas-academicas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "corepack pnpm -r --if-present run build",
    "dev": "corepack pnpm --filter @propuestas/portal-propuestas dev",
    "dev:portal": "corepack pnpm --filter @propuestas/portal-propuestas dev",
    "dev:barrio": "corepack pnpm --filter @propuestas/mejora-mi-barrio dev",
    "dev:cuaderno": "corepack pnpm --filter @propuestas/cuaderno-matematico dev",
    "dev:mascota": "corepack pnpm --filter @propuestas/encuentra-mi-mascota dev",
    "dev:nutrivision": "corepack pnpm --filter @propuestas/nutrivision dev",
    "dev:signbridge": "corepack pnpm --filter @propuestas/signbridge-ai dev",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b",
    "clean": "corepack pnpm -r --if-present run clean"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "jsdom": "26.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "4.1.6"
  }
}
