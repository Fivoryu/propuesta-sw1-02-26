{
  "name": "@propuestas/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('node:fs').rmSync('.tsbuild',{recursive:true,force:true})\""
  },
  "files": ["src", ".tsbuild", "package.json"],
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
