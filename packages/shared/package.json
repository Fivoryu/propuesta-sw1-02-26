{
  "name": "@propuestas/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts/index.ts",
      "default": "./src/contracts/index.ts"
    },
    "./fixtures": {
      "types": "./src/fixtures/index.ts",
      "default": "./src/fixtures/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('node:fs').rmSync('.tsbuild',{recursive:true,force:true})\""
  },
  "files": ["src", ".tsbuild", "package.json"],
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
